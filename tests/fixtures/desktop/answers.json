{
  "harness": { "version": 2, "commit": "fixture" },
  "project": {
    "name": "Desktop Fixture",
    "slug": "desktop-fixture",
    "description": "A desktop fixture used by the harness tests.",
    "type": "desktop",
    "license": "MIT",
    "owner": "gabrielSantosLima",
    "repo": "gabrielSantosLima/desktop-fixture"
  },
  "git": {
    "commitAutonomy": "strict",
    "defaultBranch": "main"
  },
  "quality": {
    "checks": ["npm run lint", "npm test"],
    "ciDepth": "full",
    "os": ["ubuntu-latest", "windows-latest"]
  },
  "build": {
    "command": "npm run dist",
    "artifacts": ["dist/*.exe", "dist/*.AppImage"]
  },
  "version": { "source": "tags" },
  "release": {
    "trigger": "workflow_dispatch",
    "notesLanguage": "es",
    "sections": ["features", "fixes", "chores", "other", "known-issues"],
    "attachArtifacts": true
  },
  "deploy": { "target": "none" },
  "skills": ["commit-and-push", "release-cut"],
  "hygiene": {
    "pullRequestTemplate": false,
    "codeowners": false
  },
  "ignore": ["PLAN.md", ".env", "dist/"]
}
